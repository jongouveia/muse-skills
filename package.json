{
  "name": "muse-skills",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/gate-entries.mjs --quarantine && astro build && cp dist/sitemap-index.xml dist/sitemap.xml",
    "gate": "node scripts/gate-entries.mjs",
    "gate:fix": "node scripts/gate-entries.mjs --fix-dashes",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.10",
    "lucide-astro": "^0.556.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
