---
import { jsonLdHtml } from '../../lib/json-ld';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import SkillRow from '../../components/SkillRow.astro';
import { compareEntries, isSpace } from '../../lib/categories';

// The page exists only once at least one Space entry ships. With none, no route, no sitemap URL.
export async function getStaticPaths() {
  const spaces = (await getCollection('entries')).filter(isSpace).sort(compareEntries);
  return spaces.length > 0 ? [{ params: { index: undefined }, props: { spaces } }] : [];
}

const { spaces } = Astro.props;
const site = Astro.site ?? Astro.url;
const lead = 'A Space is a tracker, planner, or board that Muse builds in your sidebar from a prompt you paste. Pick one, copy its build prompt, and paste it into your Muse chat. Each Space works from what you type in. If a spec offers an optional app connection, it says so, and Muse asks before it connects.';
const description = 'Copy a build prompt, paste it into Muse AI, and get a wedding planner, trip board, recipe collection, or money dashboard in your sidebar.';
const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Muse AI Spaces to copy',
  description,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: spaces.map((entry, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(`/entry/${entry.id}/`, site).href,
      name: entry.data.title,
    })),
  },
};
---
<Base title="Muse AI Spaces: Copy-Paste Build Prompts | Muse Skills" description={description}>
  <script type="application/ld+json" set:html={jsonLdHtml(collectionJsonLd)} />
  <div class="mx-auto w-full max-w-4xl space-y-10 px-4 py-8 md:py-10">
    <div class="space-y-6">
      <Breadcrumb items={[{ label: 'Skills', href: '/' }, { label: 'Spaces' }]} />
      <header>
        <h1 class="text-3xl font-semibold tracking-tight">Muse AI Spaces to copy</h1>
        <p class="mt-3 max-w-[65ch] text-lg text-muted-foreground">{lead}</p>
      </header>
    </div>

    <section aria-label="Spaces">
      <ul class="divide-y">
        {spaces.map((entry) => (
          <li><SkillRow entry={entry} /></li>
        ))}
      </ul>
    </section>
  </div>
</Base>
