---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <title>Muse Skills</title>
  </head>
  <body>
    <main class="og-card">
      <div>
        <p class="og-brand">Muse Skills</p>
        <p class="og-line">Ready-to-use skills for Muse AI.</p>
      </div>
      <p class="og-site">museskills.dev</p>
    </main>
  </body>
</html>
<style is:global>
  html, body { width: 1200px; height: 630px; margin: 0; color-scheme: light; }
  body { overflow: hidden; background: #ffffff; color: #09090b; }
  .og-card { position: relative; box-sizing: border-box; display: flex; flex-direction: column; justify-content: space-between; width: 1200px; height: 630px; padding: 88px; background: #ffffff; }
  .og-card::after { position: absolute; inset: 40px; border: 1px solid #e4e4e7; content: ""; pointer-events: none; }
  .og-brand { margin: 0; font-family: "Geist Variable", sans-serif; font-size: 72px; font-weight: 600; line-height: 1; letter-spacing: -0.03em; }
  .og-line { max-width: 820px; margin: 34px 0 0; color: #71717a; font-family: "Geist Variable", sans-serif; font-size: 40px; line-height: 1.15; }
  .og-site { margin: 0; font-family: "Geist Variable", sans-serif; font-size: 24px; }
</style>
