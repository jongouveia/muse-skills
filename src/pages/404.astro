---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
---
<Base title="Page not found | Muse Skills" description="That page is not in the directory." noindex>
  <div class="mx-auto flex min-h-[50vh] w-full max-w-4xl flex-col items-start justify-center px-4 py-8 md:py-10">
    <h1 class="text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-3 text-muted-foreground">That page is not in the directory.</p>
    <Button href="/" variant="outline" class="mt-6">Back to skills</Button>
  </div>
</Base>
