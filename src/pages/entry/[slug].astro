---
import { getCollection, render } from 'astro:content';
import { ExternalLink, ShieldAlert } from 'lucide-astro';
import Base from '../../layouts/Base.astro';
import CopyButton from '../../components/CopyButton.astro';
import SkillRow from '../../components/SkillRow.astro';
import Alert from '../../components/ui/Alert.astro';
import Badge from '../../components/ui/Badge.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import { categoryName, categorySlug, compareEntries, formatDate, typeName } from '../../lib/categories';

export async function getStaticPaths() {
  const entries = await getCollection('entries');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const allEntries = await getCollection('entries');
const related = allEntries
  .filter((candidate) => candidate.id !== entry.id && candidate.data.category === data.category)
  .sort(compareEntries)
  .slice(0, 4);

const title = `${data.title}: ${typeName(data.type)} for Muse AI | Muse Skills`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const site = Astro.site ?? Astro.url;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: data.title,
  description: data.tagline,
  url: canonical.href,
  codeRepository: data.source_url,
  programmingLanguage: 'Markdown',
  author: { '@type': 'Organization', name: data.author },
  datePublished: data.date_added.toISOString().slice(0, 10),
  dateModified: data.date_added.toISOString().slice(0, 10),
  version: data.version,
  keywords: data.includes.join(', '),
  isPartOf: { '@type': 'WebSite', url: new URL('/', site).href },
  publisher: { '@type': 'Organization', name: 'Muse Skills' },
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Skills', item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: categoryName(data.category), item: new URL(`/category/${categorySlug(data.category)}/`, site).href },
    { '@type': 'ListItem', position: 3, name: data.title, item: canonical.href },
  ],
};
const authorNote = data.origin === 'directory' ? 'Written for this directory' : data.source_verified ? undefined : 'Unverified source';
const sourceUrl = new URL(data.source_url);
const sourceLeaf = sourceUrl.pathname.split('/').filter(Boolean).at(-1) ?? `${entry.id}.md`;
const sourceLabel = sourceUrl.hostname === 'github.com' ? `github.com/…/${entry.id}.md` : `${sourceUrl.hostname}/…/${sourceLeaf}`;
const warnings = [
  'A shared skill carries somebody else\'s instructions. Read the source before you install it.',
  'Never paste an API key, password, or token into anything a skill asks for. Legitimate skills use Muse\'s own secure flows.',
  'Installing copies the setup into your own environment. It gives the author nothing.',
];
---
<Base title={title} description={`${data.tagline} Read the full source, then paste one install prompt into Muse AI.`} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <div class="mx-auto w-full max-w-4xl space-y-8 px-4 py-8 md:py-10">
    <Breadcrumb items={[
      { label: 'Skills', href: '/' },
      { label: categoryName(data.category), href: `/category/${categorySlug(data.category)}/` },
      { label: data.title },
    ]} />

    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-x-10 lg:gap-y-0">
      <header class="min-w-0">
          <h1 class="text-3xl font-semibold tracking-tight">{data.title}</h1>
          <p class="mt-2 text-lg text-muted-foreground">{data.tagline}</p>
          <div class="mt-4 flex flex-wrap gap-1.5">
            <Badge variant="secondary">{typeName(data.type)}</Badge>
            <Badge variant="outline" href={`/category/${categorySlug(data.category)}/`} class="hover:bg-accent">{categoryName(data.category)}</Badge>
            {data.includes.map((item) => <Badge variant="outline" class="text-[11px]">{item}</Badge>)}
          </div>
          <p class="mt-3 text-xs text-muted-foreground">
            {data.origin === 'directory' ? 'by Muse Skills editors · Written for this directory' : `shared by ${data.author}`}
          </p>
          <div class="mt-6 flex flex-wrap gap-2">
            <CopyButton text={data.install_prompt} label="Copy install prompt" statusId="install-status" />
            <Button href="#source" variant="outline">View source</Button>
          </div>
          <p id="install-status" class="mt-3 text-sm text-muted-foreground" aria-live="polite">Ready to copy.</p>
      </header>

      <aside class="mt-10 self-start lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:sticky lg:top-20 lg:mt-0">
        <Card class="p-5">
          <h2 class="text-base font-semibold">Details</h2>
          <dl class="mt-5 grid grid-cols-[88px_1fr] gap-y-3 text-sm">
            <dt class="text-muted-foreground">Type</dt><dd>{typeName(data.type)}</dd>
            <dt class="text-muted-foreground">Category</dt><dd><a class="underline" href={`/category/${categorySlug(data.category)}/`}>{categoryName(data.category)}</a></dd>
            <dt class="text-muted-foreground">Version</dt><dd>{data.version}</dd>
            <dt class="text-muted-foreground">Added</dt><dd>{formatDate(data.date_added)}</dd>
            <dt class="text-muted-foreground">Author</dt><dd>{data.author}{authorNote && <span class="mt-1 block text-xs text-muted-foreground">{authorNote}</span>}</dd>
            <dt class="text-muted-foreground">Includes</dt><dd class="flex flex-wrap gap-1">{data.includes.map((item) => <Badge variant="outline" class="text-[11px]">{item}</Badge>)}</dd>
            <dt class="text-muted-foreground">Source</dt>
            <dd class="min-w-0">
              <a class="inline-flex max-w-full items-center gap-1 underline" href={data.source_url} rel="noopener" target="_blank">
                <span class="truncate">{sourceLabel}</span><ExternalLink class="shrink-0" size={16} strokeWidth={1.5} aria-hidden="true" />
              </a>
            </dd>
          </dl>
          <CopyButton text={data.install_prompt} label="Copy install prompt" variant="outline" class="mt-6 w-full" statusId="install-status" />
        </Card>
      </aside>

      <div class="min-w-0">

        <Alert title="Before you install" class="mt-8">
          <ShieldAlert slot="icon" size={16} strokeWidth={1.5} aria-hidden="true" />
          <ul>{warnings.map((warning) => <li>{warning}</li>)}</ul>
        </Alert>

        <section class="mt-10" aria-labelledby="what-heading">
          <h2 id="what-heading" class="text-xl font-semibold">What it does</h2>
          <div class="prose"><Content /></div>
        </section>

        <section class="mt-10" aria-labelledby="scope-heading">
          <h2 id="scope-heading" class="text-xl font-semibold">What this one touches</h2>
          <p class="mt-3 whitespace-pre-line text-muted-foreground">{data.safety_notes}</p>
        </section>

        <section class="mt-10" aria-labelledby="install-heading">
          <h2 id="install-heading" class="text-xl font-semibold">Install</h2>
          <p class="mt-3 text-muted-foreground">Copy this block and paste it into your Muse chat. Muse does the install and confirms when it's done.</p>
          <Card class="mt-4 overflow-hidden">
            <div class="flex items-center justify-between gap-3 border-b p-4">
              <span class="text-sm font-medium">Install prompt</span>
              <CopyButton text={data.install_prompt} label="Copy install prompt" size="sm" variant="outline" statusId="install-status" />
            </div>
            <textarea readonly rows="12" class="w-full max-w-full resize-y overflow-auto rounded-none border-0 bg-muted p-4 font-mono text-xs leading-relaxed text-foreground">{data.install_prompt}</textarea>
          </Card>
        </section>

        <section class="mt-10" id="source" aria-labelledby="source-heading">
          <h2 id="source-heading" class="text-xl font-semibold">Full source</h2>
          <p class="mt-3 text-muted-foreground">This is the exact text Muse installs. Read it. That's the whole trust model.</p>
          <Card class="mt-4 min-w-0 overflow-hidden">
            <div class="flex items-center justify-between gap-3 border-b p-4">
              <span class="text-sm font-medium">SKILL.md</span>
              <CopyButton text={data.source} label="Copy source" size="sm" variant="outline" />
            </div>
            <pre class="max-w-full overflow-x-auto p-4 font-mono text-xs leading-relaxed"><code>{data.source}</code></pre>
          </Card>
        </section>

        {related.length > 0 && (
          <section class="mt-10" aria-labelledby="related-heading">
            <h2 id="related-heading" class="text-xl font-semibold">More in {categoryName(data.category)}</h2>
            <ul class="mt-3 divide-y">
              {related.map((relatedEntry) => <li><SkillRow entry={relatedEntry} showCategory={false} /></li>)}
            </ul>
          </section>
        )}
      </div>
    </div>
  </div>
</Base>
