---
import { Check, ChevronDown } from 'lucide-astro';
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import Input from '../components/ui/Input.astro';
import { TYPES } from '../lib/categories';

const fieldClass = 'h-9 w-full min-w-0 rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs transition-colors outline-none disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50';
const checks = [
  'The full source reads on the page. Nothing hidden behind a link.',
  'It never asks for a credential.',
  'It never sends your data to a third party.',
  'The install prompt worked end to end in a fresh Muse chat.',
  'The author is credited. Link it if you shared it publicly; otherwise a name or handle is enough.',
];
---
<Base title="Submit a skill to Muse Skills" description="Share a Muse skill, prompt pack, workflow, or config snippet. A person checks the source, the safety rules, and the install prompt before it is listed.">
  <div class="mx-auto w-full max-w-4xl px-4 py-8 md:py-10">
    <div class="max-w-2xl">
      <h1 class="text-3xl font-semibold tracking-tight">Submit a skill</h1>
    <p class="mt-3 text-muted-foreground">Share a skill, prompt pack, workflow, or config snippet. A person reviews every submission against the checklist below before it's listed.</p>

    <form id="submit-form" class="mt-8 grid gap-5">
      <div class="grid gap-2"><label class="text-sm font-medium" for="name">Name</label><Input id="name" name="name" type="text" required /></div>
      <div class="grid gap-2"><label class="text-sm font-medium" for="type">Type</label><div class="relative"><select class={`${fieldClass} appearance-none pr-9`} id="type" name="type">{TYPES.map((type) => <option value={type}>{type}</option>)}</select><ChevronDown class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground" size={16} strokeWidth={1.5} aria-hidden="true" /></div></div>
      <div class="grid gap-2"><label class="text-sm font-medium" for="source">Full source</label><textarea class={`${fieldClass} min-h-60 resize-y py-3 font-mono text-xs`} id="source" name="source" required></textarea></div>
      <div class="grid gap-2"><label class="text-sm font-medium" for="source_url">Where you shared it <span class="font-normal text-muted-foreground">optional</span></label><Input id="source_url" name="source_url" type="url" /></div>
      <div class="grid gap-2"><label class="text-sm font-medium" for="author">Your name or handle</label><Input id="author" name="author" type="text" /></div>
      <Button type="submit" class="mt-2 justify-self-start">Open a prefilled GitHub issue</Button>
    </form>

    <section aria-labelledby="checklist-heading">
      <h2 id="checklist-heading" class="mt-10 text-xl font-semibold">What we check</h2>
      <ul class="mt-4 space-y-3 text-muted-foreground">
        {checks.map((check) => <li class="flex gap-3"><Check class="mt-1 shrink-0 text-muted-foreground" size={16} strokeWidth={1.5} aria-hidden="true" /><span>{check}</span></li>)}
      </ul>
    </section>
    </div>
  </div>
</Base>

<script>
  const form = document.querySelector('#submit-form');
  if (form instanceof HTMLFormElement) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const getValue = (id: string) => {
        const field = form.querySelector(`#${id}`);
        return field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement ? field.value : '';
      };
      const name = getValue('name');
      const url = `https://github.com/jongouveia/muse-skills/issues/new?template=submission.yml&title=${encodeURIComponent(`[Submission] ${name}`)}&name=${encodeURIComponent(name)}&type=${encodeURIComponent(getValue('type'))}&source=${encodeURIComponent(getValue('source'))}&source_url=${encodeURIComponent(getValue('source_url'))}&author=${encodeURIComponent(getValue('author'))}`;
      window.open(url, '_blank', 'noopener');
    });
  }
</script>
