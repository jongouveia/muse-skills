---
import { getCollection } from 'astro:content';
import { Search, X } from 'lucide-astro';
import Base from '../layouts/Base.astro';
import SkillRow from '../components/SkillRow.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Input from '../components/ui/Input.astro';
import { CATEGORIES, TYPES, categoryName, compareEntries, typeName } from '../lib/categories';

const entries = (await getCollection('entries')).sort(compareEntries);
const total = entries.length;
const categoryRows = Object.entries(CATEGORIES).map(([slug, name]) => ({
  slug,
  name,
  count: entries.filter((entry) => entry.data.category === slug).length,
})).filter((row) => row.count > 0);
const typeRows = TYPES.map((type) => ({
  type,
  name: typeName(type),
  count: entries.filter((entry) => entry.data.type === type).length,
}));
const heroOffer = 'One paste installs the whole thing. Pick a skill, read its full source, copy the install prompt, and paste it into your Muse chat. Skills, prompt packs, scheduled workflows, and config snippets, all free.';
const metaDescription = 'Ready-to-use skills, prompt packs, scheduled workflows, and config snippets for Muse AI. Read the full source, copy one install prompt, paste it into Muse.';
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: entries.map((entry, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/entry/${entry.id}/`, Astro.site ?? Astro.url).href,
    name: entry.data.title,
  })),
};
---
<Base title="Muse Skills: one-paste skills and prompts for Muse AI" description={metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
  <div class="mx-auto w-full max-w-4xl space-y-10 px-4 py-8 md:py-10">
    <section aria-labelledby="page-title">
      <h1 id="page-title" class="text-4xl font-semibold tracking-tight">Ready-to-use skills for Muse AI.</h1>
      <p class="mt-3 max-w-[65ch] text-lg text-muted-foreground">{heroOffer}</p>
    </section>

    <Card class="space-y-4 p-4" data-filter-panel>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <div class="relative flex-1">
          <label class="sr-only" for="search">Search skills</label>
          <Search class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground" size={16} strokeWidth={1.5} aria-hidden="true" />
          <Input id="search" type="search" placeholder="Search skills" autocomplete="off" class="pl-9" data-search-input />
        </div>
        <div class="flex items-center justify-between gap-3 sm:contents">
        <Button type="button" variant="outline" size="sm" data-clear>
          <X size={16} strokeWidth={1.5} aria-hidden="true" />
          Clear filters
        </Button>
        <span class="text-sm tabular-nums text-muted-foreground" data-count>{total} of {total} skills</span>
        </div>
      </div>
      <div class="grid gap-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="w-16 text-xs text-muted-foreground">category</span>
          {categoryRows.map(({ slug, name, count }) => (
            <Badge as="button" type="button" variant="outline" class="gap-1.5 tabular-nums hover:bg-accent" data-filter data-filter-group="category" data-filter-value={slug} aria-pressed="false">
              {name} <span class="text-muted-foreground">{count}</span>
            </Badge>
          ))}
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="w-16 text-xs text-muted-foreground">type</span>
          {typeRows.map(({ type, name, count }) => (
            <Badge as="button" type="button" variant="outline" class="gap-1.5 tabular-nums hover:bg-accent" data-filter data-filter-group="type" data-filter-value={type} aria-pressed="false">
              {name} <span class="text-muted-foreground">{count}</span>
            </Badge>
          ))}
        </div>
      </div>
    </Card>

    <section aria-label="Skills">
      <ul class="divide-y" data-list>
        {entries.map((entry) => (
          <li
            data-category={entry.data.category}
            data-type={entry.data.type}
            data-search={`${entry.data.title} ${entry.data.tagline} ${categoryName(entry.data.category)} ${typeName(entry.data.type)} ${entry.data.includes.join(' ')}`.toLowerCase()}
          >
            <SkillRow entry={entry} showCategory />
          </li>
        ))}
      </ul>
      <p class="py-10 text-sm text-muted-foreground" hidden data-empty>No skills match your filters.</p>
    </section>

    <section aria-labelledby="how-heading">
      <h2 id="how-heading" class="text-xl font-semibold">How it works</h2>
      <ol class="mt-5 grid gap-6 md:grid-cols-3">
        <li class="space-y-3">
          <span class="flex size-8 items-center justify-center rounded-full bg-muted text-sm font-medium">1</span>
          <div><h3 class="font-medium">Copy</h3><p class="mt-1 text-sm text-muted-foreground">Choose Copy install prompt on any skill. The install prompt goes to your clipboard.</p></div>
        </li>
        <li class="space-y-3">
          <span class="flex size-8 items-center justify-center rounded-full bg-muted text-sm font-medium">2</span>
          <div><h3 class="font-medium">Paste</h3><p class="mt-1 text-sm text-muted-foreground">Open your Muse chat and paste the block.</p></div>
        </li>
        <li class="space-y-3">
          <span class="flex size-8 items-center justify-center rounded-full bg-muted text-sm font-medium">3</span>
          <div><h3 class="font-medium">Confirm</h3><p class="mt-1 text-sm text-muted-foreground">Muse creates the skill, asks before it schedules anything, and tells you the trigger phrases.</p></div>
        </li>
      </ol>
    </section>
  </div>
</Base>

<script>
  const panel = document.querySelector('[data-filter-panel]');
  const list = document.querySelector('[data-list]');
  const search = panel?.querySelector('[data-search-input]');
  const count = panel?.querySelector('[data-count]');
  const empty = document.querySelector('[data-empty]');
  const rows = list ? Array.from(list.querySelectorAll(':scope > li')) : [];
  const filterButtons = panel ? Array.from(panel.querySelectorAll('[data-filter]')) : [];
  let selectedCategory = '';
  let selectedType = '';

  const update = () => {
    const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
    let visible = 0;
    rows.forEach((row) => {
      if (!(row instanceof HTMLElement)) return;
      const matches = (row.dataset.search ?? '').includes(query)
        && (!selectedCategory || row.dataset.category === selectedCategory)
        && (!selectedType || row.dataset.type === selectedType);
      row.hidden = !matches;
      if (matches) visible += 1;
    });

    if (count) count.textContent = `${visible} of ${rows.length} skill${rows.length === 1 ? '' : 's'}`;
    if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
    filterButtons.forEach((button) => {
      if (!(button instanceof HTMLElement)) return;
      const selected = button.dataset.filterGroup === 'category'
        ? button.dataset.filterValue === selectedCategory
        : button.dataset.filterValue === selectedType;
      button.setAttribute('aria-pressed', String(selected));
    });

    const params = new URLSearchParams();
    if (query) params.set('q', query);
    if (selectedCategory) params.set('category', selectedCategory);
    if (selectedType) params.set('type', selectedType);
    const nextQuery = params.toString();
    history.replaceState(null, '', `${location.pathname}${nextQuery ? `?${nextQuery}` : ''}`);
  };

  const params = new URLSearchParams(location.search);
  if (search instanceof HTMLInputElement) search.value = params.get('q') ?? '';
  const requestedCategory = params.get('category') ?? '';
  const requestedType = params.get('type') ?? '';
  if (filterButtons.some((button) => button instanceof HTMLElement && button.dataset.filterGroup === 'category' && button.dataset.filterValue === requestedCategory)) selectedCategory = requestedCategory;
  if (filterButtons.some((button) => button instanceof HTMLElement && button.dataset.filterGroup === 'type' && button.dataset.filterValue === requestedType)) selectedType = requestedType;

  search?.addEventListener('input', update);
  panel?.querySelector('[data-clear]')?.addEventListener('click', () => {
    if (search instanceof HTMLInputElement) search.value = '';
    selectedCategory = '';
    selectedType = '';
    update();
  });
  filterButtons.forEach((button) => button.addEventListener('click', () => {
    if (!(button instanceof HTMLElement)) return;
    const value = button.dataset.filterValue ?? '';
    if (button.dataset.filterGroup === 'category') selectedCategory = selectedCategory === value ? '' : value;
    if (button.dataset.filterGroup === 'type') selectedType = selectedType === value ? '' : value;
    update();
  }));
  update();
</script>
