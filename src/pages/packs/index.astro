---
import Base from '../../layouts/Base.astro';
import CopyButton from '../../components/CopyButton.astro';
import Badge from '../../components/ui/Badge.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Button from '../../components/ui/Button.astro';
import { getPacks } from '../../lib/packs';

const packs = await getPacks();
const lead = 'Each pack installs four to six related skills with one paste.';
const description = `Starter packs for Muse AI: ${packs.map(({ pack }) => pack.data.title).join(', ')}. ${lead}`;
const site = Astro.site ?? Astro.url;
const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Starter packs for Muse AI | Muse Skills',
  description,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: packs.map(({ pack }, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(`/packs/${pack.id}/`, site).href,
      name: pack.data.title,
    })),
  },
};
---
<Base title="Starter packs for Muse AI | Muse Skills" description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
  <div class="mx-auto w-full max-w-4xl space-y-10 px-4 py-8 md:py-10">
    <div class="space-y-6">
      <Breadcrumb items={[{ label: 'Skills', href: '/' }, { label: 'Starter packs' }]} />
      <header>
        <h1 class="text-3xl font-semibold tracking-tight">Starter packs</h1>
        <p class="mt-3 max-w-[65ch] text-lg text-muted-foreground">{lead}</p>
      </header>
    </div>

    <section aria-label="Starter packs">
      <ul class="divide-y">
        {packs.map(({ pack, entries, installPrompt }) => (
          <li>
            <article class="flex min-w-0 flex-col gap-4 py-5 sm:flex-row sm:items-center sm:justify-between">
              <div class="min-w-0 space-y-2">
                <div>
                  <h2 class="text-base font-medium text-foreground"><a class="hover:underline" href={`/packs/${pack.id}/`}>{pack.data.title}</a></h2>
                  <p class="mt-1 text-sm text-muted-foreground">{pack.data.description}</p>
                </div>
                <ul class="flex flex-wrap gap-1.5" aria-label={`Skills in ${pack.data.title}`}>
                  {entries.map((entry) => (
                    <li class="flex"><Badge variant="outline" href={`/entry/${entry.id}/`} class="hover:bg-accent">{entry.data.title}</Badge></li>
                  ))}
                </ul>
              </div>
              <div class="flex shrink-0 flex-wrap gap-2 sm:justify-end">
                <Button href={`/packs/${pack.id}/`} variant="outline" size="sm">View</Button>
                <CopyButton text={installPrompt} label="Copy install prompt" size="sm" />
              </div>
            </article>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
