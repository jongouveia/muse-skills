---
import { jsonLdHtml } from '../../lib/json-ld';
import { ShieldAlert } from 'lucide-astro';
import Base from '../../layouts/Base.astro';
import CopyButton from '../../components/CopyButton.astro';
import SkillRow from '../../components/SkillRow.astro';
import Alert from '../../components/ui/Alert.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { getPacks } from '../../lib/packs';

export async function getStaticPaths() {
  const packs = await getPacks();
  return packs.map((resolved) => ({ params: { slug: resolved.pack.id }, props: resolved }));
}

const { pack, entries, installPrompt } = Astro.props;
const { data } = pack;
const title = `${data.title}: starter pack for Muse AI | Muse Skills`;
const site = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: data.title,
  description: data.description,
  url: canonical.href,
  datePublished: data.date_added.toISOString().slice(0, 10),
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: entries.map((entry, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(`/entry/${entry.id}/`, site).href,
      name: entry.data.title,
    })),
  },
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Skills', item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: 'Starter packs', item: new URL('/packs/', site).href },
    { '@type': 'ListItem', position: 3, name: data.title, item: canonical.href },
  ],
};
const warnings = [
  'A shared skill carries somebody else\'s instructions. Read the source before you install it.',
  'Never paste an API key, password, or token into anything a skill asks for. Legitimate skills use Muse\'s own secure flows.',
  'Installing copies the setup into your own environment. It gives the author nothing.',
];
---
<Base title={title} description={`${data.description} Install all ${entries.length} skills in Muse AI with one paste.`}>
  <script type="application/ld+json" set:html={jsonLdHtml(jsonLd)} />
  <script type="application/ld+json" set:html={jsonLdHtml(breadcrumbJsonLd)} />

  <div class="mx-auto w-full max-w-4xl space-y-8 px-4 py-8 md:py-10">
    <Breadcrumb items={[
      { label: 'Skills', href: '/' },
      { label: 'Starter packs', href: '/packs/' },
      { label: data.title },
    ]} />

    <div class="space-y-10">
    <header class="min-w-0">
      <h1 class="text-3xl font-semibold tracking-tight">{data.title}</h1>
      <p class="mt-2 max-w-[65ch] text-lg text-muted-foreground">{data.description}</p>
      <div class="mt-6 flex flex-wrap gap-2">
        <CopyButton text={installPrompt} label={`Copy all ${entries.length} install prompts`} statusId="install-status" />
      </div>
      <p id="install-status" class="mt-3 text-sm text-muted-foreground" aria-live="polite">Ready to copy.</p>
    </header>

    <Alert title="Before you install">
      <ShieldAlert slot="icon" size={16} strokeWidth={1.5} aria-hidden="true" />
      <ul>{warnings.map((warning) => <li>{warning}</li>)}</ul>
    </Alert>

    <section aria-labelledby="skills-heading">
      <h2 id="skills-heading" class="text-xl font-semibold">Skills in this pack</h2>
      <ol class="mt-5 divide-y">
        {entries.map((entry) => <li><SkillRow entry={entry} /></li>)}
      </ol>
    </section>

    </div>
  </div>
</Base>
