---
interface Props {
  isHomepage?: boolean;
}

const { isHomepage = Astro.url.pathname === '/' } = Astro.props;
const path = Astro.url.pathname;
const query = Astro.url.searchParams.get('q') ?? '';
const links = [
  { href: '/', label: 'Bank', current: isHomepage || path.startsWith('/category/') || path.startsWith('/entry/') },
  { href: '/about', label: 'About', current: path.startsWith('/about') },
];
---
<div class="masthead">
  <a class="masthead-brand" href="/" aria-label="Muse Skills home">Muse Skills</a>
  <nav class="masthead-nav" aria-label="Primary navigation">
    {links.map((link) => (
      <a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>
  <form class="search-form" action="/" method="get" role="search">
    <label class="sr-only" for="search">Search skills</label>
    <input class="search-input" id="search" name="q" type="search" placeholder="Search skills" value={query} autocomplete="off" />
  </form>
  <a class="masthead-cta" href="/submit" aria-current={path.startsWith('/submit') ? 'page' : undefined}>Submit a skill</a>
</div>
{!isHomepage && <script is:inline>
  const searchForm = document.querySelector('.search-form');
  searchForm?.addEventListener('submit', (event) => {
    const input = searchForm.querySelector('input[name="q"]');
    if (!input) return;
    event.preventDefault();
    window.location.href = `/?q=${encodeURIComponent(input.value)}`;
  });
</script>}
