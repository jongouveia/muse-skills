---
import { CATEGORIES } from '../lib/categories';
---
<div class="footer-columns">
  <div class="footer-column">
    <span class="footer-heading">Browse</span>
    <a href="/">Bank</a>
    {Object.entries(CATEGORIES).map(([slug, name]) => <a href={`/category/${slug}`}>{name}</a>)}
  </div>
  <div class="footer-column">
    <span class="footer-heading">Project</span>
    <a href="/about">About</a>
    <a href="/submit">Submit a skill</a>
    <a href="https://github.com/jongouveia/muse-skills" rel="noopener">GitHub</a>
  </div>
</div>
<p class="footer-note">Independent community directory. Not affiliated with Meta.</p>
<p class="footer-note">Questions or corrections: <a href="https://github.com/jongouveia/muse-skills/issues" rel="noopener">open an issue on GitHub</a>.</p>
