---
interface Props {
  text: string;
  label: string;
}

const { text, label } = Astro.props;
---
<button type="button" class="load-key" data-copy={text} aria-label={label}>{label}</button>
<textarea class="fallback-text" data-fallback readonly aria-label={label}>{text}</textarea>
<script is:inline>
  if (!window.__museLoadKeyBound) {
    window.__museLoadKeyBound = true;
    document.addEventListener('click', async (event) => {
      const target = event.target;
      const button = target instanceof Element ? target.closest('.load-key') : null;
      if (!(button instanceof HTMLButtonElement)) return;
      const text = button.dataset.copy ?? '';
      const action = button.closest('.load-action');
      const status = action?.querySelector('[data-status]');
      try {
        if (!navigator.clipboard?.writeText) throw new Error('Clipboard unavailable');
        await navigator.clipboard.writeText(text);
        button.dataset.state = 'loaded';
        if (status) status.textContent = 'Loaded. Paste it into your Muse chat.';
        window.setTimeout(() => {
          delete button.dataset.state;
          if (status) status.textContent = 'Ready. Press Load to copy the install prompt.';
        }, 2000);
      } catch {
        const fallback = action?.querySelector('[data-fallback]');
        if (fallback instanceof HTMLTextAreaElement) {
          fallback.focus();
          fallback.select();
        }
      }
    });
  }
</script>
