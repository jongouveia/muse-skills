---
import Button from './ui/Button.astro';
import Input from './ui/Input.astro';

// Set PUBLIC_BUTTONDOWN_USERNAME in the Vercel project env. Unset: the form does not render.
const username = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME as string | undefined;
---
{username && (
  <form
    class="grid gap-2"
    action={`https://buttondown.com/api/emails/embed-subscribe/${encodeURIComponent(username)}`}
    method="post"
  >
    <label class="text-foreground" for="newsletter-email">Get new skills by email each week</label>
    <div class="flex gap-2">
      <Input id="newsletter-email" name="email" type="email" required autocomplete="email" />
      <input type="hidden" name="embed" value="1" />
      <Button type="submit">Subscribe</Button>
    </div>
  </form>
)}
