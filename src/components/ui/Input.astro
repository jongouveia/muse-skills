---
interface Props {
  class?: string;
  [key: string]: unknown;
}

const { class: className = '', ...rest } = Astro.props;
---
<input class={`h-9 w-full min-w-0 rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs transition-colors outline-none placeholder:text-muted-foreground disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 ${className}`} {...rest} />
