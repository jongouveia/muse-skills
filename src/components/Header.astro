---
import { Moon, Search, Sun } from 'lucide-astro';
import Button from './ui/Button.astro';
import Input from './ui/Input.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../lib/categories';

const { category } = Astro.props as { category?: string };
const path = Astro.url.pathname;
const isHomepage = path === '/';
const query = Astro.url.searchParams.get('q') ?? '';
const links = [
  { href: '/', label: 'Skills', current: path === '/' || path.startsWith('/category/') || path.startsWith('/entry/') },
  { href: '/about/', label: 'About', current: path.startsWith('/about') },
];
const entries = await getCollection('entries');
const categoryLinks = Object.entries(CATEGORIES).filter(([slug]) => entries.some((entry) => entry.data.category === slug)).map(([slug, name]) => ({
  href: `/category/${slug}/`,
  label: name,
  current: path.startsWith(`/category/${slug}/`) ? 'page' : category === slug ? 'true' : undefined,
}));
---
<header class="sticky top-0 z-50 border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/80">
  <div class="mx-auto flex h-14 w-full max-w-4xl items-center gap-3 px-4">
    <a class="flex shrink-0 items-center gap-2 font-semibold" href="/" aria-label="Muse Skills home, an independent directory not affiliated with Meta">
      Muse Skills
      <span class="rounded-md border border-mark/45 px-1.5 py-px text-xs font-medium leading-4 text-mark" title="Community run. Not affiliated with Meta.">Independent</span>
    </a>
    <nav class="hidden items-center gap-3 sm:flex" aria-label="Primary navigation">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={['text-sm transition-colors hover:text-foreground', link.current ? 'text-foreground' : 'text-muted-foreground']}
          aria-current={link.current ? 'page' : undefined}
        >{link.label}</a>
      ))}
    </nav>
    <div class="ml-auto flex min-w-0 items-center gap-2">
      {!isHomepage && <form class="relative hidden w-44 md:block" action="/" method="get" role="search">
        <label class="sr-only" for="header-search">Search skills</label>
        <Search class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground" size={16} strokeWidth={1.5} aria-hidden="true" />
        <Input id="header-search" name="q" type="search" placeholder="Search skills" value={query} autocomplete="off" class="pl-9" />
      </form>}
      <Button variant="ghost" size="icon" type="button" aria-label="Toggle theme" data-theme-toggle>
        <Sun class="theme-icon-sun" size={16} strokeWidth={1.5} aria-hidden="true" />
        <Moon class="theme-icon-moon" size={16} strokeWidth={1.5} aria-hidden="true" />
      </Button>
      <Button href="/submit/" size="sm" aria-current={path.startsWith('/submit') ? 'page' : undefined}>Submit a skill</Button>
    </div>
  </div>
  <nav class="category-nav relative mx-auto w-full max-w-4xl overflow-x-auto px-4" aria-label="Categories">
    <ul class="flex h-10 items-stretch gap-5 whitespace-nowrap">
      {categoryLinks.map((link) => (
        <li class="flex">
          <a
            href={link.href}
            class:list={['category-nav-link flex items-center text-sm transition-colors hover:text-foreground', link.current ? 'font-medium text-foreground' : 'text-muted-foreground']}
            aria-current={link.current}
          >{link.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const categoryNav = document.querySelector<HTMLElement>('.category-nav');
  const currentCategory = categoryNav?.querySelector<HTMLElement>('[aria-current]');
  if (categoryNav && currentCategory) {
    categoryNav.scrollLeft = currentCategory.offsetLeft - (categoryNav.clientWidth - currentCategory.offsetWidth) / 2;
  }

  const themeButton = document.querySelector('[data-theme-toggle]');
  themeButton?.addEventListener('click', () => {
    const root = document.documentElement;
    const nextDark = !root.classList.contains('dark');
    root.classList.toggle('dark', nextDark);
    localStorage.setItem('theme', nextDark ? 'dark' : 'light');
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', nextDark ? '#09090b' : '#ffffff');
  });
</script>
