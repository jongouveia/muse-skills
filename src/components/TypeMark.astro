---
interface Props {
  type: 'skill' | 'prompt' | 'workflow' | 'config';
}

const { type } = Astro.props;
---
<span class="type-mark" aria-label={type}>
  {type === 'skill' && <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 2.5h8.5v3H14v8H3z" /><path d="M11.5 2.5v3H14" /></svg>}
  {type === 'prompt' && <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 3h11v7.5h-6l-3.5 3V10h-1.5z" /></svg>}
  {type === 'workflow' && <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5.5" /><path d="M8 4.5V8l2.5 1.5M8 1v1M8 14v1M1 8h1M14 8h1" /></svg>}
  {type === 'config' && <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12" /><path d="M5 2.5v3M11 6.5v3M7 10.5v3" /></svg>}
  <span>{type}</span>
</span>
