---
import type { CollectionEntry } from 'astro:content';
import type { AstroComponentFactory } from 'astro';
import { categoryName, formatDate } from '../lib/categories';
import TypeMark from './TypeMark.astro';
import LoadKey from './LoadKey.astro';

interface Props {
  entry: CollectionEntry<'entries'>;
  body: AstroComponentFactory;
  headingLevel?: 1 | 2;
  showLoad?: boolean;
  showSourceLink?: boolean;
  warningsHeading?: string;
}

const { entry, body: Body, headingLevel = 2, showLoad = true, showSourceLink = false, warningsHeading = 'Warnings' } = Astro.props;
const { data } = entry;
const warnings = [
  'A shared skill carries somebody else\'s instructions. Read the source before you install it.',
  'Never paste an API key, password, or token into anything a skill asks for. Legitimate skills use Muse\'s own secure flows.',
  'Installing copies the setup into your own environment. It gives the author nothing.',
];
---
<article class="sheet" id={`sheet-${entry.id}`} data-sheet={entry.id} aria-labelledby={`sheet-title-${entry.id}`}>
  <div class="sheet-main">
    {headingLevel === 1 ? (
      <h1 class="sheet-title" id={`sheet-title-${entry.id}`}>{data.title}</h1>
    ) : (
      <h2 class="sheet-title" id={`sheet-title-${entry.id}`}>{data.title}</h2>
    )}
    <p class="sheet-tagline">{data.tagline}</p>
    <div class="sheet-content">
      <section aria-labelledby={`uses-${entry.id}`}>
        <h3 class="sheet-label" id={`uses-${entry.id}`}>Uses</h3>
        <Body />
      </section>
      <section class="warnings-block" aria-labelledby={`warnings-${entry.id}`}>
        <h3 class="sheet-label" id={`warnings-${entry.id}`}>{warningsHeading}</h3>
        <ul class="warnings-list">
          {warnings.map((warning) => <li>{warning}</li>)}
          <li class="safety-note">{data.safety_notes}</li>
        </ul>
      </section>
    </div>
  </div>
  <aside class="sheet-load-column" aria-label="Patch details and install">
    <TypeMark type={data.type} />
    <dl class="metadata">
      <div class="metadata-item"><dt class="meta-label">Type</dt><dd class="meta-value">{data.type}</dd></div>
      <div class="metadata-item"><dt class="meta-label">Category</dt><dd class="meta-value">{categoryName(data.category)}</dd></div>
      <div class="metadata-item"><dt class="meta-label">Version</dt><dd class="meta-value">{data.version}</dd></div>
      <div class="metadata-item"><dt class="meta-label">Added</dt><dd class="meta-value">{formatDate(data.date_added)}</dd></div>
      <div class="metadata-item"><dt class="meta-label">Author</dt><dd class="meta-value"><a class="source-link" href={data.source_url}>{data.author}</a></dd></div>
      <div class="metadata-item metadata-includes"><dt class="meta-label">Includes</dt><dd class="includes-chips">{data.includes.map((item) => <span class="include-chip">{item}</span>)}</dd></div>
    </dl>
    {showLoad && (
      <div class="load-action">
        <LoadKey text={data.install_prompt} label="Copy install prompt" />
        <p class="load-status" data-status aria-live="polite">Ready. Press Load to copy the install prompt.</p>
        {showSourceLink && <a class="sheet-source-link" href={`/entry/${entry.id}/`}>Read the full source</a>}
      </div>
    )}
  </aside>
</article>
