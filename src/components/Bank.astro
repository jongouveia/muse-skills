---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES, categoryName } from '../lib/categories';
import { orderedBankEntries } from '../lib/bank';
import PatchSheet from './PatchSheet.astro';

interface Props {
  entries: CollectionEntry<'entries'>[];
}

const { entries } = Astro.props;
const categoryGroups = (Object.keys(CATEGORIES) as Array<keyof typeof CATEGORIES>)
  .map((category) => ({
    category,
    entries: orderedBankEntries(entries).filter((entry) => entry.data.category === category),
  }))
  .filter((group) => group.entries.length > 0);
const orderedEntries = orderedBankEntries(entries);
const slotNumbers = new Map(orderedEntries.map((entry, index) => [entry.id, index + 1]));
const requestedSlot = Astro.url.searchParams.get('slot');
const activeSlug = orderedEntries.some((entry) => entry.id === requestedSlot)
  ? requestedSlot
  : orderedEntries.some((entry) => entry.id === 'deal-hunter')
    ? 'deal-hunter'
    : orderedEntries[0]?.id;
const renderedSheets = await Promise.all(
  orderedEntries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  }),
);
---
<section class="bank-region" data-bank aria-labelledby="bank-heading">
  <div class="bank-legend-row">
    <h2 class="section-title" id="bank-heading">Skill bank</h2>
  </div>
  <div class:list={["bank-strip", { "bank-strip-wrap": orderedEntries.length > 12 }]} role="tablist" aria-label="Skill bank slots">
    {categoryGroups.map(({ category, entries: groupEntries }) => (
      <div class="bank-group" style={`--group-slots:${groupEntries.length}`}>
        <span class="bank-group-label" title={categoryName(category)}>{categoryName(category)}</span>
        <div class="bank-group-slots">
          {groupEntries.map((entry) => {
            const number = slotNumbers.get(entry.id) ?? 0;
            const isActive = entry.id === activeSlug;
            return (
              <>
                {'\n'}
                <button
                  class="slot-button"
                  type="button"
                  role="tab"
                  aria-selected={isActive}
                  aria-controls="patch-sheet-panel"
                  data-slot={entry.id}
                  data-search={`${entry.data.title} ${entry.data.tagline} ${categoryName(entry.data.category)}`.toLowerCase()}
                >
                  <span class="slot-number">{String(number).padStart(2, '0')}</span>
                  <span class="slot-name">{entry.data.title}</span>
                </button>
                {'\n'}
              </>
            );
          })}
        </div>
      </div>
    ))}
  </div>
  <div class="sheet-region" id="patch-sheet-panel" role="tabpanel" aria-label="Selected skill">
    {renderedSheets.map(({ entry, Content }) => (
      <div class="sheet-slot" data-sheet-slot={entry.id} hidden={entry.id !== activeSlug}>
        <PatchSheet entry={entry} body={Content} showSourceLink />
      </div>
    ))}
  </div>
</section>
<script>
  const bank = document.querySelector('[data-bank]');

  if (bank) {
    const tabButtons = Array.from(bank.querySelectorAll('.slot-button'));
    const sheetSlots = Array.from(bank.querySelectorAll('[data-sheet-slot]'));
    const searchInput = document.querySelector('#search');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let activeSlot = tabButtons.find((button) => button.getAttribute('aria-selected') === 'true')?.dataset.slot ?? '';

    const updateUrl = (slug) => {
      const params = new URLSearchParams(window.location.search);
      params.set('slot', slug);
      const query = params.toString();
      window.history.replaceState(null, '', `${window.location.pathname}${query ? `?${query}` : ''}`);
    };

    const activateSlot = (slug, { redraw = true, replaceUrl = true } = {}) => {
      const nextButton = tabButtons.find((button) => button.dataset.slot === slug);
      if (!nextButton) return;
      activeSlot = slug;
      tabButtons.forEach((button) => {
        button.setAttribute('aria-selected', String(button === nextButton));
      });
      sheetSlots.forEach((slot) => {
        const isActive = slot.dataset.sheetSlot === slug;
        slot.hidden = !isActive;
        slot.setAttribute('aria-hidden', String(!isActive));
        if (isActive && redraw) {
          const sheet = slot.querySelector('.sheet');
          if (sheet && !reducedMotion.matches) {
            sheet.classList.remove('redraw-sheet');
            void sheet.offsetWidth;
            sheet.classList.add('redraw-sheet');
            window.setTimeout(() => sheet.classList.remove('redraw-sheet'), 280);
          }
        }
      });
      if (replaceUrl) updateUrl(slug);
    };

    const filterBank = (value, replaceUrl = false) => {
      const query = value.trim().toLowerCase();
      const matches = tabButtons.filter((button) => (button.dataset.search ?? '').includes(query));
      tabButtons.forEach((button) => {
        button.dataset.hidden = String(!matches.includes(button));
      });
      const activeMatches = matches.some((button) => button.dataset.slot === activeSlot);
      if (query && !activeMatches && matches[0]?.dataset.slot) {
        activateSlot(matches[0].dataset.slot, { redraw: false, replaceUrl });
      } else if (activeSlot) {
        activateSlot(activeSlot, { redraw: false, replaceUrl: false });
      }
    };

    const initialQuery = searchInput instanceof HTMLInputElement ? searchInput.value : '';
    filterBank(initialQuery);

    searchInput?.addEventListener('input', (event) => {
      const input = event.currentTarget;
      if (input instanceof HTMLInputElement) filterBank(input.value, true);
    });

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const tab = target.closest('.slot-button');
      if (tab && bank.contains(tab)) {
        event.preventDefault();
        if (tab.dataset.slot) activateSlot(tab.dataset.slot);
        return;
      }
      const jump = target.closest('[data-jump-slot]');
      if (jump instanceof HTMLElement && jump.dataset.jumpSlot) {
        event.preventDefault();
        activateSlot(jump.dataset.jumpSlot);
        bank.scrollIntoView({ block: 'start' });
      }
    });
  }
</script>
